            ok, msg = apply_gpu_setting(idx, "fan_speed", val)
            window["-OC_LOG-"].print(f"[Fan GPU{idx}] {'OK' if ok else 'FAIL'}: {msg}")

        #  All: Apply to all GPUs
        elif event == "-APPLY_POWER_ALL-":
            val = values.get("-OC_POWER-", "")
