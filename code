        elif event == "-APPLY_CORE_ALL-":
            val = values.get("-OC_CORE-", "")
            gc = window.metadata.get("gpu_count", 1)
            window["-OC_LOG-"].print(f"[Core ALL] 正在应用到 {gc} 个GPU...")
            for i in range(gc):
                ok, msg = apply_gpu_setting(str(i), "core_clock", val)
                window["-OC_LOG-"].print(f"  GPU{i}: {'OK' if ok else 'FAIL'}: {msg}")

        elif event == "-APPLY_MEM_ALL-":
            val = values.get("-OC_MEM-", "")
            gc = window.metadata.get("gpu_count", 1)
            window["-OC_LOG-"].print(f"[Mem ALL] 正在应用到 {gc} 个GPU...")
            for i in range(gc):
                ok, msg = apply_gpu_setting(str(i), "mem_clock", val)
                window["-OC_LOG-"].print(f"  GPU{i}: {'OK' if ok else 'FAIL'}: {msg}")

        elif event == "-APPLY_FAN_ALL-":
            val = values.get("-OC_FAN-", "")
            gc = window.metadata.get("gpu_count", 1)
            window["-OC_LOG-"].print(f"[Fan ALL] 正在应用到 {gc} 个GPU...")
            for i in range(gc):
                ok, msg = apply_gpu_setting(str(i), "fan_speed", val)
                window["-OC_LOG-"].print(f"  GPU{i}: {'OK' if ok else 'FAIL'}: {msg}")

        #  reset 
        elif event == "-OC_RESET-":
            idx = _get_selected_gpu(values)
            results = reset_gpu_settings(idx)
            for name, ok in results:
                window["-OC_LOG-"].print(f"[Reset GPU{idx}-{name}] {'OK' if ok else 'FAIL'}")

        elif event == "-OC_RESET_ALL-":
            gc = window.metadata.get("gpu_count", 1)
            window["-OC_LOG-"].print(f"[Reset ALL] 正在重置 {gc} 个GPU设置...")
            for i in range(gc):
                results = reset_gpu_settings(i)
                for name, ok in results:
                    window["-OC_LOG-"].print(f"  GPU{i}-{name}: {'OK' if ok else 'FAIL'}")


        elif event == "-APPLY_RESTART-":
            hrs = values.get("-AUTO_RESTART-", "0")
            try:
                h = float(hrs)
                secs = int(h * 3600)
                ok = schedule_restart(hrs)
                if ok:
                    window["-AUTO_LOG-"].print(f"{t("restart_set")}: {h}h")
                else:
                    window["-AUTO_LOG-"].print(t("restart_fail"))
            except ValueError:
                window["-AUTO_LOG-"].print(t("invalid_number"))
        
        elif event == "-CANCEL_RESTART-":
            cancel_restart()
            window["-AUTO_LOG-"].print(t("restart_cancelled"))
        
        elif event == "-SAVE_AUTO-":
            config["auto_restart_hours"] = values.get("-AUTO_RESTART-", "0")
            config["low_hash_threshold"] = values.get("-LOW_HASH-", "0")
            config["low_hash_minutes"] = values.get("-LOW_HASH_MIN-", "30")
            config["auto_start_mining"] = "1" if values.get("-AUTO_START_MINING-") else "0"
            config["auto_startup"] = "1" if values.get("-AUTO_STARTUP-") else "0"
            save_config(config)
            manage_startup(config["auto_startup"] == "1")
            window["-AUTO_LOG-"].print(t("settings_saved"))
    
    window.close()

