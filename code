def _ab_shm_ready():
    """通过 Afterburner 获取风扇转速"""
    import ctypes
    from ctypes import wintypes
    try:
        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        OpenFileMapping = kernel32.OpenFileMappingW
        OpenFileMapping.restype = wintypes.HANDLE
        OpenFileMapping.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.LPCWSTR]
        handle = OpenFileMapping(0x0004, False, "MAHMSharedMemory")
        if handle:
            kernel32.CloseHandle(handle)
            return True
        return False
    except:
        return False

def _ab_set_fan(gpu_idx, speed_percent):
    """通过 Afterburner 设置风扇转速"""
    import ctypes, struct
    from ctypes import wintypes
    
    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    OpenFileMapping = kernel32.OpenFileMappingW
    OpenFileMapping.restype = wintypes.HANDLE
    OpenFileMapping.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.LPCWSTR]
    MapViewOfFile = kernel32.MapViewOfFile
    MapViewOfFile.restype = wintypes.LPVOID
    MapViewOfFile.argtypes = [wintypes.HANDLE, wintypes.DWORD, wintypes.DWORD, wintypes.DWORD, ctypes.c_size_t]
    UnmapViewOfFile = kernel32.UnmapViewOfFile
    CloseHandle = kernel32.CloseHandle
    
    handle = OpenFileMapping(0x0006, False, "MAHMSharedMemory")
    if not handle:
        return (False, "无法找到 Afterburner 窗口")
    
    view = MapViewOfFile(handle, 0x0006, 0, 0, 65536)
    if not view:
        CloseHandle(handle)
        return (False, "无法找到 Afterburner 控件")
    
    try:
        buf = (ctypes.c_byte * 65536).from_address(ctypes.cast(view, ctypes.c_void_p).value)
        raw = bytes(buf)
        
        entry_count = struct.unpack_from("<I", raw, 8)[0]
        entry_size = struct.unpack_from("<I", raw, 12)[0]
        
        # Traverse all controls to find fans
        fan_entry_idx = -1
        for e in range(entry_count):
            entry_off = 32 + e * entry_size
            if entry_off + entry_size > len(raw):
                break
            entry = raw[entry_off:entry_off + entry_size]
            
            # matching fan
            null_idx = entry.find(b'\x00')
            name = entry[:null_idx].decode('ascii', errors='replace').strip() if null_idx > 0 else ""
            
            if "fan" in name.lower() and "speed" in name.lower():
                fan_entry_idx = e
                break
            elif "fan" in name.lower():
                fan_entry_idx = e  # Save fan control index
                # don't break, try to find "fan speed"
        
        if fan_entry_idx < 0:
            return (False, "未检测到风扇控件 (请确认Afterburner皮肤中风扇控件可见)")
        
        # Read fan speed
        entry_off = 32 + fan_entry_idx * entry_size
        entry = raw[entry_off:entry_off + entry_size]
        null_idx = entry.find(b'\x00')
        data_start = ((null_idx + 4) // 4) * 4 if null_idx > 0 else 64
        
        if data_start + 16 <= entry_size:
            d = entry[data_start:]
            flags = struct.unpack_from("<I", d, 16)[0] if len(d) >= 20 else 0
            
            if not (flags & 0x01):
                return (False, "无法读取转速 (请确认Afterburner运行中)")
            
            # parsing (float at offset 4 in data section)
            new_val = struct.pack("<f", float(speed_percent))
            target_addr = ctypes.cast(view, ctypes.c_void_p).value + entry_off + data_start + 4
            ctypes.memmove(target_addr, new_val, 4)
            
            return (True, f"风扇已设为 {speed_percent}% (MSI Afterburner)")
        
        return (False, "设置风扇转速失败")
    finally:
        UnmapViewOfFile(view)
        CloseHandle(handle)


def _set_power_limit_nvapi(gpu_idx, watts_limit):
    """使用 NVAPI 设置 GPU 功率限制"""
    try:
        import ctypes
        
        nvapi = ctypes.WinDLL("nvapi64.dll")
        query = nvapi.nvapi_QueryInterface
        query.restype = ctypes.c_void_p
        query.argtypes = [ctypes.c_uint]
        
        # load NVAPI
        INIT_FUNC = ctypes.CFUNCTYPE(ctypes.c_int)
        NvAPI_Initialize = INIT_FUNC(query(0x0150E828))
        if NvAPI_Initialize() != 0:
            return (False, "NVAPI 加载失败")
        
        # obtain GPU
        ENUM_FUNC = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.POINTER(ctypes.c_uint))
        NvAPI_EnumPhysicalGPUs = ENUM_FUNC(query(0xE5AC921F))
        gpu_handles = (ctypes.c_void_p * 32)()
        gpu_count = ctypes.c_uint(0)
        status = NvAPI_EnumPhysicalGPUs(gpu_handles, ctypes.byref(gpu_count))
        if status != 0 or gpu_count.value == 0:
            return (False, "未检测到 GPU")
        
        if gpu_idx >= gpu_count.value:
            return (False, f"GPU 索引 {gpu_idx} 无效")
        
        handle = gpu_handles[gpu_idx]
        
        # Obtain the power limit range (NVAPI ID: 0x185DD05F)
        GET_POWER_LIMITS = ctypes.CFUNCTYPE(
            ctypes.c_int, ctypes.c_void_p,
            ctypes.POINTER(ctypes.c_uint),  # min (mW)
            ctypes.POINTER(ctypes.c_uint),  # default (mW)
            ctypes.POINTER(ctypes.c_uint),  # max (mW)
            ctypes.POINTER(ctypes.c_uint),  # step (mW)
            ctypes.POINTER(ctypes.c_uint),  # default policy
        )
        NvAPI_GPU_GetPowerLimitRange = GET_POWER_LIMITS(query(0x185DD05F))
        
        min_pwr = ctypes.c_uint(0)
        def_pwr = ctypes.c_uint(0)
        max_pwr = ctypes.c_uint(0)
        step = ctypes.c_uint(0)
        def_policy = ctypes.c_uint(0)
        
        status = NvAPI_GPU_GetPowerLimitRange(
            handle, ctypes.byref(min_pwr), ctypes.byref(def_pwr),
            ctypes.byref(max_pwr), ctypes.byref(step), ctypes.byref(def_policy)
        )
        
        if status != 0:
            # If it is 0, the default power consumption limit will be restored
            min_w, max_w = 50, 600  # default range
            return _try_set_power_nvapi(handle, query, watts_limit, min_w, max_w)
        
        min_w = min_pwr.value / 1000.0
        max_w = max_pwr.value / 1000.0
        
        if watts_limit < min_w or watts_limit > max_w:
            return (False, f"功率 {watts_limit}W 超出范围 ({int(min_w)}W - {int(max_w)}W)")
        
        return _try_set_power_nvapi(handle, query, watts_limit, min_w, max_w)
        
    except OSError:
        return (False, "NVAPI 不可用 (nvapi64.dll 未找到)")
    except Exception as e:
        return (False, f"NVAPI 异常: {str(e)}")


def _try_set_power_nvapi(handle, query, watts_limit, min_w, max_w):
    """设置功率限制并保存到注册表"""
    import ctypes
    
    # NvAPI_GPU_SetPowerLimit (ID: 0x0DAD9BFF)
    SET_POWER_LIMIT_FUNC = ctypes.CFUNCTYPE(
        ctypes.c_int, ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint, ctypes.c_uint
    )
    NvAPI_GPU_SetPowerLimit = SET_POWER_LIMIT_FUNC(query(0x0DAD9BFF))
    
    target_mw = ctypes.c_uint(int(watts_limit * 1000))
    last_status = 0
    
    # save power limit policy + source to registry
    for policy in [1, 0, 2]:
        for source in [0, 1]:
            status = NvAPI_GPU_SetPowerLimit(handle, target_mw, ctypes.c_uint(policy), ctypes.c_uint(source))
            last_status = status
            if status == 0:
                return (True, f"功率限制已设为 {watts_limit}W (NVAPI)")
    
    # Read bug
    GET_ERR = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.c_char_p)
    NvAPI_GetErrorMessage = GET_ERR(query(0x6C2D048C))
    buf = ctypes.create_string_buffer(256)
    NvAPI_GetErrorMessage(last_status, buf)
    return (False, f"NVAPI 设置失败: {buf.value.decode()}")


def detect_gpus():
    """Detect all NVIDIA GPUs, return list of (index, name)."""
    try:
        r = subprocess.run(
            ["nvidia-smi", "--query-gpu=index,name", "--format=csv,noheader"],
            capture_output=True, text=True, timeout=10
        )
        if r.returncode == 0 and r.stdout.strip():
            gpus = []
            for line in r.stdout.strip().split("\n"):
                parts = line.split(",", 1)
                if len(parts) == 2:
                    gpus.append((parts[0].strip(), parts[1].strip()))
            return gpus
    except:
        pass
    return [("0", "GPU (nvidia-smi not available)")]

def reset_gpu_settings(gpu_idx):
    results = []
    
    # Save core frequency
    try:
        r = _run(
            ["nvidia-smi", "--query-gpu=power.default_limit",
             "--format=csv,noheader", "-i", str(gpu_idx)],
            capture_output=True, text=True, timeout=10
        )
        if r.returncode == 0 and r.stdout.strip():
            def_watts = int(float(r.stdout.strip().replace(" W", "").strip()))
            r2 = _run(
                ["nvidia-smi", "-i", str(gpu_idx), "-pl", str(def_watts)],
                capture_output=True, text=True, timeout=10
            )
            results.append(("power limit", r2.returncode == 0))
        else:
            results.append(("power limit", False))
    except:
        results.append(("power limit", False))
    
    # Save graphics card memory frequency
    r1 = _run(
        ["nvidia-smi", "-i", str(gpu_idx), "-rgc"],
        capture_output=True, text=True, timeout=10
    )
    results.append(("core clock", r1.returncode == 0))
    
    # Save fan speed
    r2 = _run(
        ["nvidia-smi", "-i", str(gpu_idx), "-rmc"],
        capture_output=True, text=True, timeout=10
    )
    results.append(("mem clock", r2.returncode == 0))
    
    # Reset all settings (0 = default)
    try:
        ok, _ = _set_fan_speed_nvapi(int(gpu_idx), 0)
        results.append(("fan speed", ok))
    except:
        results.append(("fan speed", False))
    
    # Save settings
    try:
        r3 = _run(
            ["nvidia-smi", "-i", str(gpu_idx), "-auto-boost-default"],
            capture_output=True, text=True, timeout=10
        )
        results.append(("auto boost", r3.returncode == 0))
    except:
        results.append(("auto boost", False))
    
    return results

