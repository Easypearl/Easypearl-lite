def main():
    # Single instance check via Windows mutex
    import ctypes.wintypes
    ERROR_ALREADY_EXISTS = 183
    mutex = ctypes.windll.kernel32.CreateMutexW(None, False, "EasypearlLite_SingleInstance")
    if ctypes.windll.kernel32.GetLastError() == ERROR_ALREADY_EXISTS:
        sg.popup(t("title") + " is already running!", title=t("title"))
        sys.exit(0)
    
    if not is_admin():
        sg.popup(t("no_permission"))
    window = create_window()
    window.metadata = {}
    window.metadata = {}
    config = load_config()
    
    # Refresh GPU list
    gpus = detect_gpus()
    gpu_names = [f"GPU {i}: {name}" for i, name in gpus]
    window["-OC_GPU-"].update(values=gpu_names, set_to_index=0)
    window.metadata["gpus"] = gpus
    window.metadata["gpu_count"] = len(gpus)
    
    window["-MINER_TYPE-"].update(config.get("miner_type", "pminer"))
    window["-WALLET-"].update(config.get("wallet", ""))
    window["-POOL-"].update(config.get("pool", ""))
    window["-WORKER-"].update(config.get("worker_name", ""))
    window["-GPU_IDX-"].update(config.get("gpu_index", "0"))
    window["-AUTO_RESTART-"].update(config.get("auto_restart_hours", "0"))
    window["-LOW_HASH-"].update(config.get("low_hash_threshold", "0"))
    window["-LOW_HASH_MIN-"].update(config.get("low_hash_minutes", "30"))
    window["-AUTO_START_MINING-"].update(config.get("auto_start_mining", "0") == "1")
    window["-AUTO_STARTUP-"].update(config.get("auto_startup", "0") == "1")
    
    # Load language
    lang = config.get("language", "zh")
    lang_display = {"zh":"中文","en":"English","ru":"Русский","de":"Deutsch","es":"Español"}
    window["-LANG-"].update(lang_display.get(lang, "中文"))
    apply_language(window, lang)
    
    # Windows startup
    manage_startup(config.get("auto_startup", "0") == "1")
    
    # Auto-start mining timer (30s after launch)
    if config.get("auto_start_mining", "0") == "1":
        window.metadata["_auto_start_time"] = time.time() + 30
        window["-AUTO_LOG-"].print(t("auto_start_msg"))
    
    last_gpu_refresh = 0
    
    while True:
        event, values = window.read(timeout=2000)
        now = time.time()

        # Auto-start mining after 30s
        auto_start_t = window.metadata.get("_auto_start_time", 0)
        if auto_start_t and now >= auto_start_t:
            window.metadata["_auto_start_time"] = 0
            if window["-START-"].Widget.cget("state") != "disabled":
                window["-AUTO_LOG-"].print(t("auto_starting"))
                window.write_event_value("-START-", "auto")

        if event in (sg.WIN_CLOSED, None):
            stop = window.metadata.get("stop") if hasattr(window, "metadata") else None
            if stop and isinstance(stop, list) and len(stop) > 0:
                stop[0] = True
            proc = window.metadata.get("_process") if hasattr(window, "metadata") else None
            if proc is not None:
                try:
                    proc.terminate()
                    time.sleep(0.3)
                    proc.kill()
                except:
                    pass
            cancel_restart()
            break

        
        # Low hashrate check (every 60s when mining)
        mining_active = window["-START-"].Widget.cget("state") == "disabled"
        if mining_active:
            last_hr_check = window.metadata.get("_last_hr_check", 0)
            if now - last_hr_check > 60:
                window.metadata["_last_hr_check"] = now
                if check_low_hashrate(config, window):
                    mins = float(config.get("low_hash_minutes", "30"))
                    hours = mins / 60.0
                    if schedule_restart(hours):
                        window["-LOG-"].print(f"[Low Hashrate] Restart scheduled in {int(mins)}min!")
        
        # Regularly refresh GPU monitoring
        if now - last_gpu_refresh > 3:
            last_gpu_refresh = now
            stats = get_all_gpu_stats()
            if stats:
                txt = "--------------------------------------------------------------------------------\n"
                txt += f"{'Index':<6}{'Name':<24}{'Temp':<8}{'Fan':<8}{'Power':<12}{'Core':<12}{'Mem':<12}\n"
                txt += "--------------------------------------------------------------------------------\n"
                for s in stats:
                    txt += f"{s['index']:<6}{s['name']:<24}{s['temp']:<8}{s['fan']:<8}{s['power']:<12}{s['core_clock']:<12}{s['mem_clock']:<12}\n"
                window["-GPU_MONITOR-"].update(txt)
                window["-GPU_REFRESH_TIME-"].update(time.strftime("%H:%M:%S"))
            else:
                window["-GPU_MONITOR-"].update("GPU info unavailable")
        
        
        if event == "-LANG-":
            lang_map = {"中文":"zh","English":"en","Русский":"ru","Deutsch":"de","Español":"es"}
            lang = lang_map.get(values["-LANG-"], "zh")
            apply_language(window, lang)
            config["language"] = lang
            save_config(config)
        
        if event == "-LOG_LINE-":
            line = values["-LOG_LINE-"]
            window["-LOG-"].print(line, end="")
            hr = parse_hashrate(line)
            if hr:
                window["-HASHRATE-"].update(f"{t("hashrate")}: {hr}")
            continue

        if event == "-START-":
            config["miner_type"] = values.get("-MINER_TYPE-", config["miner_type"])
            config["wallet"] = values.get("-WALLET-", config["wallet"])
            config["pool"] = values.get("-POOL-", config["pool"])
            config["worker_name"] = values.get("-WORKER-", config["worker_name"])
            config["gpu_index"] = values.get("-GPU_IDX-", config["gpu_index"])
            
            # Regularly restart monitoring
            old_stop = window.metadata.get("stop") if hasattr(window, "metadata") else None
            if old_stop and isinstance(old_stop, list) and len(old_stop) > 0:
                old_stop[0] = True
            old_proc = window.metadata.get("_process") if hasattr(window, "metadata") else None
            if old_proc is not None:
                try:
                    old_proc.terminate()
                    old_proc.kill()
                except:
                    pass
                window.metadata["_process"] = None
            time.sleep(0.8)
            
            window["-START-"].update(disabled=True)
            window["-STOP-"].update(disabled=False)
            window["-LOG-"].update("")
            
            thread = threading.Thread(target=miner_thread, args=(window, config), daemon=True)
            window.metadata["thread"] = thread
            thread.start()
        
        elif event == "-STOP-":
            stop = window.metadata.get("stop") if hasattr(window, "metadata") else None
            if stop and isinstance(stop, list) and len(stop) > 0:
                stop[0] = True
            proc = window.metadata.get("_process") if hasattr(window, "metadata") else None
            if proc is not None:
                try:
                    proc.terminate()
                    time.sleep(0.3)
                    try:
                        proc.wait(timeout=2)
                    except subprocess.TimeoutExpired:
                        proc.kill()
                except:
                    try:
                        proc.kill()
                    except:
                        pass
                window.metadata["_process"] = None
            window["-START-"].update(disabled=False)
            window["-STOP-"].update(disabled=True)
            cancel_restart()
            window["-LOG-"].print(t("mining_stopped"))
            window["-HASHRATE-"].update(f"{t("hashrate")}: ---")
        elif event == "-SAVE_CFG-":
            config["miner_type"] = values.get("-MINER_TYPE-", config["miner_type"])
            config["wallet"] = values.get("-WALLET-", config["wallet"])
            config["pool"] = values.get("-POOL-", config["pool"])
            config["worker_name"] = values.get("-WORKER-", config["worker_name"])
            config["gpu_index"] = values.get("-GPU_IDX-", config["gpu_index"])
            save_config(config)
            sg.popup("配置已保存！")
        
        elif event == "-LOAD_CFG-":
            config = load_config()
            window["-MINER_TYPE-"].update(config.get("miner_type", "pminer"))
            window["-WALLET-"].update(config.get("wallet", ""))
            window["-POOL-"].update(config.get("pool", ""))
            window["-WORKER-"].update(config.get("worker_name", ""))
            window["-GPU_IDX-"].update(config.get("gpu_index", "0"))
            sg.popup("配置已加载！")
        
        elif event == "-SYS_SETTINGS-":
            show_system_settings(window)
        
        # OC
        # GPU OC incident
        elif event == "-OC_GPU-":
            gpu_sel = values.get("-OC_GPU-", "")
            if gpu_sel:
                gpu_idx = int(gpu_sel.split(":")[0].replace("GPU ", ""))
                stats = get_all_gpu_stats()
                if stats and gpu_idx < len(stats):
                    s = stats[gpu_idx]
                    window["-OC_GPU_STATUS-"].update(
                        f"GPU{gpu_idx}: {s['name']} | {s['temp']} | Fan:{s['fan']} | Power:{s['power']} | Core:{s['core_clock']} | Mem:{s['mem_clock']}"
                    )

        elif event == "-OC_REFRESH_GPU-":
            gpus = detect_gpus()
            gpu_names = [f"GPU {i}: {name}" for i, name in gpus]
            window["-OC_GPU-"].update(values=gpu_names)
            window.metadata["gpus"] = gpus
            window.metadata["gpu_count"] = len(gpus)
            window["-OC_LOG-"].print(f"[OK] Refreshed: {len(gpus)} GPUs")

        #  Single graphics card: application
        elif event == "-APPLY_POWER-":
            idx = _get_selected_gpu(values)
            val = values.get("-OC_POWER-", "")
            ok, msg = apply_gpu_setting(idx, "power_limit", val)
            window["-OC_LOG-"].print(f"[Power GPU{idx}] {'OK' if ok else 'FAIL'}: {msg}")

        elif event == "-APPLY_CORE-":
