def resource_path(relative_path):
    try:
        base_path = sys._MEIPASS
    except AttributeError:
        base_path = os.path.dirname(os.path.abspath(__file__))
    return os.path.join(base_path, relative_path)

def load_config():
    if os.path.exists(CONFIG_FILE):
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            cfg = json.load(f)
        merged = DEFAULT_CONFIG.copy()
        merged.update(cfg)
        return merged
    else:
        cfg = DEFAULT_CONFIG.copy()
        save_config(cfg)
        return cfg

def save_config(config):
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(config, f, indent=4, ensure_ascii=False)

def build_miner_cmd(config, miner_exe):
    miner_type = config.get("miner_type", "pminer")
    if miner_type == "AlphaMiner":
        pool_url = config["pool"]
        m = re.search(r"://([^/]+)", pool_url)
        host_port = m.group(1) if m else pool_url
        if ":" in host_port:
            pool_host, pool_port = host_port.split(":", 1)
        else:
            pool_host = host_port
            pool_port = "8888"
        gpu_idx = config.get("gpu_index", "0")
        return [miner_exe, config["wallet"], config["worker_name"], gpu_idx, pool_host, pool_port]
    elif miner_type == "pminer":
        return [
            miner_exe, "--pearl-mine",
            "--pool", config["pool"],
            "--wallet", config["wallet"],
            "--worker", config["worker_name"],
            "--device", config.get("gpu_index", "0"),
        ]
    else:
        return [
            miner_exe,
            "--algo", "AUTOLYKOS2",
            "--pool", config["pool"],
            "--wallet", config["wallet"],
            "--worker", config.get("worker_name", "worker1"),
            "--devices", config.get("gpu_index", "0"),
        ]

def parse_hashrate(line):
    # Pattern 1: "hashrate: 123.45 TH/s" or "HASHRATE=123.45Th/s"
    m = re.search(r"hashrate[\s:=\-\[\]]+(\d+\.?\d*)\s*(TH/s|Th/s|GH/s|Gh/s|MH/s|Mh/s|KH/s|Kh/s|Sol/s|H/s)", line, re.IGNORECASE)
    if m:
        return f"{m.group(1)} {m.group(2)}"
    # Pattern 2: Any "123.45 TH/s" or "123.45 Th/s" (exclude EFFIC)
    if not re.search(r"effic|eff", line, re.IGNORECASE):
        m = re.search(r"(\d+\.?\d*)\s*(TH/s|Th/s|GH/s|Gh/s|MH/s|Mh/s|KH/s|Kh/s|Sol/s)", line)
        if m:
            return f"{m.group(1)} {m.group(2)}"
    # Pattern 3: lpminer table row (box-drawing with columns)
    if "│" in line:
        parts = [p.strip() for p in line.split("│")]
        if len(parts) >= 3:
            val = parts[2]
            m = re.match(r"(\d+\.?\d*)$", val)
            if m:
                return f"{m.group(1)} MH/s"
    return None
def get_gpu_info():
    result = _run(["nvidia-smi"], capture_output=True, text=True, timeout=10)
    if result.returncode == 0:
        return result.stdout.strip()
    return None

def get_all_gpu_stats():
    try:
        result = _run(
            ["nvidia-smi", "--query-gpu=index,name,temperature.gpu,fan.speed,power.draw,clocks.current.graphics,clocks.current.memory", "--format=csv,noheader"],
            capture_output=True, text=True, timeout=5
        )
        if result.returncode == 0 and result.stdout.strip():
            lines = result.stdout.strip().split("\n")
            stats = []
            for line in lines:
                parts = [p.strip() for p in line.split(",")]
                if len(parts) >= 7:
                    stats.append({
                        "index": parts[0],
                        "name": parts[1],
                        "temp": parts[2],
                        "fan": parts[3],
                        "power": parts[4],
                        "core_clock": parts[5],
                        "mem_clock": parts[6],
                    })
            return stats
        return None
    except:
        return None

def gpu_clock_offset_str(offset_str):
    v = offset_str.strip()
    if v in ("", "0", "-"):
        return None
    return str(int(v))

def apply_gpu_setting(gpu_idx, key, value):
    try:
        if key == "power_limit":
            watts = int(value)
            if watts == 0:
                # SET default POWER MODE
                r = _run(
                    ["nvidia-smi", "--query-gpu=power.default_limit",
                     "--format=csv,noheader", "-i", str(gpu_idx)],
                    capture_output=True, text=True, timeout=10
                )
                if r.returncode == 0 and r.stdout.strip():
                    def_watts = int(float(r.stdout.strip().replace(" W", "")))
                    r2 = _run(
                        ["nvidia-smi", "-i", str(gpu_idx), "-pl", str(def_watts)],
                        capture_output=True, text=True, timeout=10
                    )
                    if r2.returncode == 0:
                        return (True, f"已恢复默认功耗限制 ({def_watts}W)")
                    return (False, f"设置失败: {r2.stderr.strip()}")
                return (False, "无法获取默认功耗")
            
            r = _run(
                ["nvidia-smi", "-i", str(gpu_idx), "-pl", str(watts)],
                capture_output=True, text=True, timeout=10
            )
            if r.returncode == 0:
                return (True, f"功耗限制已设为 {watts}W")
            err = r.stderr.strip() or r.stdout.strip() or "未知错误"
            return (False, f"设置失败: {err}")
        
        elif key == "core_clock":
            v = value.strip()
            if v in ("", "0", "-"):
                r = _run(
                    ["nvidia-smi", "-i", str(gpu_idx), "-rgc"],
                    capture_output=True, text=True, timeout=10
                )
                return (r.returncode == 0, r.stderr.strip() or "核心频率设置成功")
            v = str(int(v))
            r = _run(
                ["nvidia-smi", "-i", str(gpu_idx), "-lgc", v],
                capture_output=True, text=True, timeout=10
            )
            return (r.returncode == 0, r.stderr.strip() or f"核心频率设为 {v} MHz")
        
        elif key == "mem_clock":
            v = value.strip()
            if v in ("", "0", "-"):
                r = _run(
                    ["nvidia-smi", "-i", str(gpu_idx), "-rmc"],
                    capture_output=True, text=True, timeout=10
                )
                return (r.returncode == 0, r.stderr.strip() or "显存频率设置成功")
            v = str(int(v))
            r = _run(
                ["nvidia-smi", "-i", str(gpu_idx), "-lmc", v],
                capture_output=True, text=True, timeout=10
            )
            return (r.returncode == 0, r.stderr.strip() or f"显存频率设为 {v} MHz")
        
        elif key == "fan_speed":
            speed = int(value)
            if speed < 0 or speed > 100:
                return (False, "风扇转速请输入 0-100 的值")
            return _set_fan_speed_nvapi(int(gpu_idx), speed)
        
        else:
            return (False, "unknown setting")
    except Exception as e:
        return (False, str(e))

def _set_fan_speed_nvapi(gpu_idx, speed_percent):
    """使用 NVML 设置 GPU 风扇转速 (支持 RTX 50 系列)"""
    try:
        import ctypes, glob, os
        
        # TRY nvml.dll ( NVSMI GETING SAME DLL)
        nvml_path = None
        search_paths = [
            r"C:\Windows\System32\DriverStore\FileRepository\nv_dispsi.inf_amd64_*\nvml.dll",
            r"C:\Windows\System32\nvml.dll",
            os.path.expandvars(r"%ProgramFiles%\NVIDIA Corporation\NVSMI\nvml.dll"),
        ]
        for pattern in search_paths:
            matches = glob.glob(pattern)
            if matches:
                nvml_path = matches[0]
                break
        
        if not nvml_path:
            return _set_fan_speed_fallback(gpu_idx, speed_percent)
        
        nvml = ctypes.WinDLL(nvml_path)
        
        # Initialization
        nvml.nvmlInit.restype = ctypes.c_int
        if nvml.nvmlInit() != 0:
            return _set_fan_speed_fallback(gpu_idx, speed_percent)
        
        try:
            # GET GPU HANDLE
            count = ctypes.c_uint(0)
            nvml.nvmlDeviceGetCount_v2.restype = ctypes.c_int
            nvml.nvmlDeviceGetCount_v2.argtypes = [ctypes.POINTER(ctypes.c_uint)]
            if nvml.nvmlDeviceGetCount_v2(ctypes.byref(count)) != 0 or count.value == 0:
                return _set_fan_speed_fallback(gpu_idx, speed_percent)
            
            if gpu_idx >= count.value:
                return _set_fan_speed_fallback(gpu_idx, speed_percent)
            
            handle = ctypes.c_void_p(0)
            nvml.nvmlDeviceGetHandleByIndex_v2.restype = ctypes.c_int
            nvml.nvmlDeviceGetHandleByIndex_v2.argtypes = [ctypes.c_uint, ctypes.POINTER(ctypes.c_void_p)]
            nvml.nvmlDeviceGetHandleByIndex_v2(gpu_idx, ctypes.byref(handle))
            
            if speed_percent == 0:
                # SET manual MODE
                nvml.nvmlDeviceSetFanControlPolicy.restype = ctypes.c_int
                nvml.nvmlDeviceSetFanControlPolicy.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint]
                r = nvml.nvmlDeviceSetFanControlPolicy(handle, 0, 0)  # 0 = auto
                if r == 0:
                    return (True, "风扇恢复自动控制")
                return _set_fan_speed_fallback(gpu_idx, speed_percent)
            
            # SET GPU FAN
            nvml.nvmlDeviceSetFanControlPolicy.restype = ctypes.c_int
            nvml.nvmlDeviceSetFanControlPolicy.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint]
            nvml.nvmlDeviceSetFanControlPolicy(handle, 0, 1)  # 1 = manual
            
            # CONFIRN
            nvml.nvmlDeviceSetFanSpeed_v2.restype = ctypes.c_int
            nvml.nvmlDeviceSetFanSpeed_v2.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_uint]
            r = nvml.nvmlDeviceSetFanSpeed_v2(handle, 0, speed_percent)
            
            if r == 0:
                return (True, f"风扇已设为 {speed_percent}% (NVML)")
            return _set_fan_speed_fallback(gpu_idx, speed_percent)
        finally:
            nvml.nvmlShutdown.restype = ctypes.c_int
            nvml.nvmlShutdown()
    except Exception:
        return _set_fan_speed_fallback(gpu_idx, speed_percent)


