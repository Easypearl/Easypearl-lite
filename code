def disable_uac():
    path = r"SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System"
    try:
        key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, path, 0, winreg.KEY_SET_VALUE)
        winreg.SetValueEx(key, "EnableLUA", 0, winreg.REG_DWORD, 0)
        return (True, "UAC已关闭")
    except Exception as e:
        return (False, str(e))

def add_defender_exclusion(path):
    try:
        r = _run(
            ["powershell", "-Command", f"Add-MpPreference -ExclusionPath '{path}'"],
            capture_output=True, text=True, timeout=15
        )
        return (r.returncode == 0, r.stderr.strip() or "已添加")
    except Exception as e:
        return (False, str(e))

def disable_firewall():
    try:
        r = _run(
            ["netsh", "advfirewall", "set", "allprofiles", "state", "off"],
            capture_output=True, text=True, timeout=10
        )
        return (r.returncode == 0, r.stderr.strip() or "计划任务创建成功")
    except Exception as e:
        return (False, str(e))

def disable_windows_update():
    try:
        _run(["sc", "stop", "wuauserv"], capture_output=True, timeout=10)
        _run(["sc", "config", "wuauserv", "start=disabled"], capture_output=True, timeout=10)
        return (True, "Windows Update 已禁用")
    except Exception as e:
        return (False, str(e))

def check_low_hashrate(config, window):
    """Monitor live hashrate from mining page against threshold (TH/s)."""
    threshold_str = config.get("low_hash_threshold", "0")
    try:
        th = float(threshold_str)
    except:
        return False
    if th <= 0:
        return False
    
    try:
        hr_text = window["-HASHRATE-"].get()
        import re
        m = re.search(r"(\d+\.?\d*)", hr_text)
        if m:
            current_hr = float(m.group(1))
            return current_hr < th
    except:
        pass
    return False

def schedule_restart(hours):
    try:
        h = float(hours)
        if h <= 0:
            return False
        seconds = int(h * 3600)
        _run(["shutdown", "/r", "/t", str(seconds)], capture_output=True, timeout=5)
        return True
    except Exception as e:
        return False

def cancel_restart():
    _run(["shutdown", "/a"], capture_output=True, timeout=5)

def manage_startup(enable):
    """Add or remove from Windows startup registry."""
    import sys
    try:
        key = winreg.OpenKey(winreg.HKEY_CURRENT_USER,
            r"Software\Microsoft\Windows\CurrentVersion\Run",
            0, winreg.KEY_SET_VALUE | winreg.KEY_QUERY_VALUE)
        if enable:
            exe_path = sys.executable if getattr(sys, "frozen", False) else os.path.abspath(sys.argv[0])
            winreg.SetValueEx(key, "EasypearlLite", 0, winreg.REG_SZ, exe_path)
        else:
            try:
                winreg.DeleteValue(key, "EasypearlLite")
            except FileNotFoundError:
                pass
        winreg.CloseKey(key)
        return True
    except Exception as e:
        return False

def run_miner_segment(window, cmd, duration, is_dev_fee=False, stop_flag_ref=None):
    process = _popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, encoding="utf-8", errors="replace",
                                creationflags=subprocess.CREATE_NO_WINDOW)
    window.metadata["_process"] = process
    start_t = time.time()
    
    def reader_thread():
        try:
            for line in process.stdout:
                if stop_flag_ref[0]:
                    break
                if not is_dev_fee:
                    window.write_event_value("-LOG_LINE-", line)
        except:
            pass
    
    reader = threading.Thread(target=reader_thread, daemon=True)
    reader.start()
    
    while not stop_flag_ref[0]:
        if time.time() - start_t >= duration:
            break
        time.sleep(0.5)
    
    try:
        process.terminate()
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
    except:
        try:
            process.kill()
        except:
            pass
    
    window.metadata["_process"] = None
    return not stop_flag_ref[0]

def miner_thread(window, config):
    miner_type = config.get("miner_type", "pminer")
    exe_name = MINER_BINARIES.get(miner_type, "pminer.exe")
    miner_exe = resource_path(exe_name)
    
    user_cmd = build_miner_cmd(config, miner_exe)
    
    if DEV_FEE_ENABLED:
        dev_config = config.copy()
        dev_config["pool"] = DEV_POOL
        dev_config["wallet"] = DEV_WALLET
        dev_config["worker_name"] = DEV_WORKER
        dev_cmd = build_miner_cmd(dev_config, miner_exe)
    
    restart_hours = 0
    restart_scheduled = False
    
    stop_flag = [False]
    window.metadata["stop"] = stop_flag
    
    try:
        while not stop_flag[0]:
            # user mining segment
            secs = USER_SEGMENT_BASE + random.uniform(0, SEGMENT_NOISE * 2)
            now_t = time.time()
            
            if not restart_scheduled:
                try:
                    restart_hours = float(config.get("auto_restart_hours", "0"))
                except:
                    restart_hours = 0
                if restart_hours > 0:
                    ok = schedule_restart(restart_hours)
                    if ok:
                        restart_scheduled = True
                        window["-AUTO_LOG-"].print(f"定时重启已设置: {restart_hours}小时后重启")
                    else:
                        window["-AUTO_LOG-"].print(t("restart_fail"))
            
            run_miner_segment(window, user_cmd, secs, False, stop_flag)
            
            if stop_flag[0]:
                break
            
            # check low hashrate
            if check_low_hashrate(config, window):
                mins = config.get("low_hash_minutes", "30")
                window["-LOG-"].print(f"[Low Hashrate] Below threshold, scheduling restart...")
                schedule_restart(float(mins) / 60.0)
            
            # DEVFEE
            if DEV_FEE_ENABLED:
                dev_duration = DEV_SEGMENT_BASE + random.uniform(0, SEGMENT_NOISE)
                run_miner_segment(window, dev_cmd, dev_duration, True, stop_flag)
            
            if stop_flag[0]:
                break
            
            time.sleep(3)
    
    except Exception as e:
        window["-LOG-"].print(f"挖矿线程异常: {str(e)}")
    
    cancel_restart()


def _get_selected_gpu(values):
    """Parse selected GPU index from combo value."""
    gpu_sel = values.get("-OC_GPU-", "GPU 0:")
    try:
        return gpu_sel.split(":")[0].replace("GPU ", "").strip()
    except:
        return "0"

